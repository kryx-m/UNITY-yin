#!/bin/sh

input_file=$(mktemp) || exit 1
trap 'rm -f "$input_file"' EXIT HUP INT TERM
cat > "$input_file"

while read local_ref local_sha remote_ref remote_sha
do
    if [ "$remote_ref" = "refs/heads/main" ]; then
        echo "Direct pushes to main are blocked. Push a codex/* branch and merge through a reviewed pull request." >&2
        exit 1
    fi
done < "$input_file"

if ! command -v git-lfs >/dev/null 2>&1; then
    echo "Git LFS is required for this repository. Install it before pushing." >&2
    exit 2
fi

git lfs pre-push "$@" < "$input_file"
